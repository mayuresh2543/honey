<?xml version="1.0" encoding="utf-8"?>
<!--
    Minimal layout for OverlayCaptureActivity.
    The PreviewView gives the camera HAL a real surface to write frames to —
    without it, some camera HALs enter a degraded mode where ImageCapture.takePicture()
    silently times out. The 1x1dp size makes it invisible to the user.
    The root FrameLayout has a transparent background — combined with the
    Theme.HoneyfileSecurity.Transparent theme, the entire window is invisible.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:alpha="0"
        android:layout_gravity="top|start" />

</FrameLayout>
