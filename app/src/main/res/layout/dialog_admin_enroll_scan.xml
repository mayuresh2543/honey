<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/appCardColor"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="?attr/appCardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tvEnrollTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸 Facial Biometric Enrollment"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEnrollSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Align your face in the center of the camera preview"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <!-- Live CameraX Preview Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="280dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/primary_accent"
            app:strokeWidth="2dp"
            android:layout_marginBottom="16dp">

            <androidx.camera.view.PreviewView
                android:id="@+id/enrollPreviewView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelEnroll"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCaptureEnroll"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.4"
                android:layout_marginStart="10dp"
                android:text="📸 Capture Profile"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_accent"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
