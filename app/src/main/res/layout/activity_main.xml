<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackgroundColor">

    <!-- Hidden 1dp PreviewView required by CameraX hardware HAL on physical devices -->
    <androidx.camera.view.PreviewView
        android:id="@+id/hiddenPreviewView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="invisible" />

    <!-- Top Executive Header Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:layout_alignParentTop="true">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Honeyfile Security"
                    android:textColor="?attr/appTextColorPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deception &amp; Endpoint Protection"
                android:textColor="?attr/appTextColorSecondary"
                android:textSize="11sp"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTheme"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/theme_toggle_label"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="12sp"
            app:thumbIcon="@drawable/ic_theme_toggle_icon" />

    </LinearLayout>

    <!-- Main Content Container (ViewPager / Tab Switcher View) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/topBar"
        android:layout_above="@id/bottomNavigation">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="20dp">

                <!-- TAB 1: OVERVIEW DASHBOARD -->
                <LinearLayout
                    android:id="@+id/tabOverview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <!-- System Hero Status Banner Card -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="?attr/appCardColor"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/appCardStrokeColor"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="20dp"
                            android:gravity="center_horizontal">

                            <TextView
                                android:id="@+id/tvProtectionBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="● ARMED &amp; MONITORING"
                                android:textColor="@color/success_green"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="8dp"
                                android:background="@drawable/badge_rounded_green" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Honeyfile Deception Engine"
                                android:textColor="?attr/appTextColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Silent Camera Capture &amp; Facial Auth Enabled"
                                android:textColor="?attr/appTextColorSecondary"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Test Trigger Access Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTrigger"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="@string/trigger_button_text"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary_accent"
                        app:cornerRadius="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Security Analytics 3-Grid Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="5dp"
                            app:cardBackgroundColor="?attr/appCardColor"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="1dp"
                            app:strokeColor="?attr/appCardStrokeColor"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvTotalLogs"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="?attr/appTextColorPrimary"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total Logs"
                                    android:textColor="?attr/appTextColorSecondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginHorizontal="5dp"
                            app:cardBackgroundColor="?attr/appCardColor"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="1dp"
                            app:strokeColor="?attr/appCardStrokeColor"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvAdminCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/success_green"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Admin Passes"
                                    android:textColor="?attr/appTextColorSecondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="5dp"
                            app:cardBackgroundColor="?attr/appCardColor"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="1dp"
                            app:strokeColor="?attr/appCardStrokeColor"
                            app:strokeWidth="1dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/tvIntruderCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="@color/alert_red"
                                    android:textSize="24sp"
                                    android:textStyle="bold" />
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Intruders"
                                    android:textColor="?attr/appTextColorSecondary"
                                    android:textSize="11sp"
                                    android:layout_marginTop="2dp" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>

                <!-- TAB 2: FOLDER SCANNER & MONITOR -->
                <LinearLayout
                    android:id="@+id/tabScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:cardBackgroundColor="?attr/appCardColor"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="2dp"
                        app:strokeColor="?attr/appCardStrokeColor"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="18dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📂 Monitored Directory Engine"
                                android:textColor="?attr/appTextColorPrimary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <!-- Folder Path Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/card_live_feed_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ACTIVE MONITORED DIRECTORY"
                                    android:textColor="?attr/appTextColorSecondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvSelectedFolder"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_folder_selected"
                                    android:textColor="?attr/appTextColorPrimary"
                                    android:textSize="13sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="middle"
                                    android:singleLine="true" />

                                <TextView
                                    android:id="@+id/tvScanStats"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Scanned Files: 0 | Honeyfiles Detected: 0"
                                    android:textColor="@color/primary_accent"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- Live Activity Ticker Box -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:padding="14dp"
                                android:layout_marginTop="12dp"
                                android:background="@drawable/card_live_feed_bg">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="REAL-TIME FILE ACTIVITY FEED"
                                    android:textColor="?attr/appTextColorSecondary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvLatestFileChange"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/no_changes_yet"
                                    android:textColor="@color/success_green"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:maxLines="3" />

                            </LinearLayout>

                            <!-- Actions Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="16dp">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSelectFolder"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="48dp"
                                    android:layout_weight="1"
                                    android:text="@string/btn_select_folder"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="12dp" />

                                <com.google.android.material.materialswitch.MaterialSwitch
                                    android:id="@+id/switchAutoScan"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:text="@string/auto_scan_label"
                                    android:textColor="?attr/appTextColorPrimary"
                                    android:textSize="12sp" />

                            </LinearLayout>

                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- TAB 3: INTRUDER PHOTO VAULT -->
                <LinearLayout
                    android:id="@+id/tabVault"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📷 Captured Intruder Photo Vault"
                        android:textColor="?attr/appTextColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvGallery"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp" />

                </LinearLayout>

                <!-- TAB 4: AUDIT LOGS -->
                <LinearLayout
                    android:id="@+id/tabLogs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📜 Security Access Audit Logs"
                        android:textColor="?attr/appTextColorPrimary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLogs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />

                </LinearLayout>

            </FrameLayout>
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="76dp"
        android:layout_alignParentBottom="true"
        android:background="?attr/appCardColor"
        app:elevation="8dp"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemActiveIndicatorStyle="@null"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

</RelativeLayout>
