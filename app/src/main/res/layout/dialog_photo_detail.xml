<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="?attr/appCardColor"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeColor="?attr/appCardStrokeColor"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚨 Intruder Evidence Detail"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Captured front-camera snapshot on unauthorized file access"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/appCardStrokeColor"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:id="@+id/ivDetailPhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="Intruder Photo Preview" />

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvDetailFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File Target: admin_passwords.txt"
            android:textColor="?attr/appTextColorPrimary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetailTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Captured: 2026-08-04 22:15:00"
            android:textColor="?attr/appTextColorSecondary"
            android:textSize="12sp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCloseDetail"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Close"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareEvidence"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.2"
                android:layout_marginStart="10dp"
                android:text="📤 Share Evidence"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_accent"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
